{
  "name": "pravo-na-dlanu",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "predev": "npm run pdf:prepare && npm run search:index",
    "build": "npm run pdf:prepare && npm run search:index && tsx scripts/build-static.ts",
    "start": "serve out",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "search:index": "tsx scripts/index-search.ts",
    "laws:sync": "tsx scripts/sync-laws.ts --refresh",
    "laws:resume": "tsx scripts/sync-laws.ts",
    "laws:audit": "tsx scripts/audit-laws.ts",
    "laws:scans": "tsx scripts/import-facsimiles.ts",
    "hosting:check": "tsx scripts/check-hosting.ts",
    "pdf:prepare": "tsx scripts/prepare-pdf-reader.ts",
    "build:measure": "tsx scripts/measure-build.ts"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@xyflow/react": "^12.12.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.69.0",
    "next": "16.4.5",
    "pdfjs-dist": "^6.5.438",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "tw-animate-css": "^1.4.0",
    "unified": "^11.0.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/turndown": "^5.0.6",
    "cheerio": "^1.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "fflate": "^0.8.3",
    "pagefind": "^1.6.0",
    "prettier": "^3.9.10",
    "serve": "^14.2.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "turndown": "^7.2.5",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "^5"
  },
  "overrides": {
    "serve": {
      "compression": "1.8.2"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.4"
    }
  },
  "type": "module"
}
